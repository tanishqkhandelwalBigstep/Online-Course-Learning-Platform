{
  "info": {
    "_postman_id": "3f2b1a9c-0000-4a00-9000-colearnbackend1",
    "name": "Online Learning Platform API",
    "description": "CoLearn backend REST API. Set {{baseUrl}}, then run Auth > Login (it captures the access & refresh tokens automatically). All protected requests inherit Bearer {{accessToken}}.",
